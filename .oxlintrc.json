{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "off",
    "restriction": "off",
    "pedantic": "off",
    "perf": "off",
    "nursery": "off"
  },
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": "off",
    "node/no-sync": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-process-exit": "off",
    "max-lines": [
      "error",
      {
        "max": 600,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 150,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**/*.mjs"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 900,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
