{
  "name": "epic-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Codex plugin for turning long-running engineering efforts into durable epic workspaces across agent sessions.",
  "author": "Oleg Proskurin <usulpro@gmail.com> (https://github.com/usulpro)",
  "license": "MIT",
  "homepage": "https://github.com/usulpro/epic-loop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usulpro/epic-loop.git"
  },
  "bugs": {
    "url": "https://github.com/usulpro/epic-loop/issues"
  },
  "type": "module",
  "scripts": {
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "lint": "oxlint scripts plugins/epic-loop/skills/epic-loop/scripts tests packages/cli/src packages/cli/scripts",
    "format:check": "oxfmt --check package.json .oxlintrc.json .oxfmtrc.json \"scripts/*.mjs\" \"tests/**/*.mjs\" \"packages/cli/src/**/*.mjs\" \"packages/cli/scripts/**/*.mjs\" \"plugins/epic-loop/skills/epic-loop/scripts/**/*.mjs\"",
    "format:write": "oxfmt --write package.json .oxlintrc.json .oxfmtrc.json \"scripts/*.mjs\" \"tests/**/*.mjs\" \"packages/cli/src/**/*.mjs\" \"packages/cli/scripts/**/*.mjs\" \"plugins/epic-loop/skills/epic-loop/scripts/**/*.mjs\"",
    "validate": "for f in scripts/*.mjs plugins/epic-loop/skills/epic-loop/scripts/*.mjs plugins/epic-loop/skills/epic-loop/scripts/lib/*.mjs; do node --check \"$f\" || exit 1; done && pnpm run lint && pnpm run format:check && node scripts/validate-epic-loop-package.mjs",
    "validate:epic-loop": "pnpm run validate",
    "doctor:epic-loop:codex": "node plugins/epic-loop/skills/epic-loop/scripts/doctor.mjs --platform codex --json",
    "doctor:epic-loop:claude-code": "node plugins/epic-loop/skills/epic-loop/scripts/doctor.mjs --platform claude-code --json",
    "eval-fixture-reset": "node scripts/eval-fixture-reset.mjs",
    "self-update": "node scripts/self-update-skill.mjs"
  },
  "keywords": [
    "codex",
    "codex-plugin",
    "agent-skills",
    "epic",
    "automation",
    "hooks"
  ],
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0"
  }
}
