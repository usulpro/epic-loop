# Dependencies
node_modules/
/.pnp
.pnp.js

# Local environment
.env
.env.*
!.env.example

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS/editor noise
.DS_Store
*.swp
*.swo

# Codex local project state
.codex/hooks.json

# Build/cache output
coverage/
dist/
build/
.cache/
temp/
.validation-output/

# Runtime skill copies and local agent state stay untracked; repo-maintenance skills are committed.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/release-epic/
!.claude/skills/sandbox-test/
.codex
.epic-loop/.runtime/
.epic-loop/epics/*/.runtime/

# epic-loop CLI build output (skill copy shipped in the npm package)
packages/cli/skill/

# Python bytecode (sandbox-test tools)
__pycache__/
*.pyc
